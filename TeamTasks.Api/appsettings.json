{
  "ConnectionStrings": {
    "DefaultConnection": "Host=db;Database=teamtasks_db;Username=admin;Password=teamtasks-passwd"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "TeamTasks.Api",
    "Audience": "TeamTasks.Application"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowInSeconds": 60,
    "QueueLimit": 2,
    "AuthPermitLimit": 5,
    "AuthWindowInSeconds": 10
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  }
}
